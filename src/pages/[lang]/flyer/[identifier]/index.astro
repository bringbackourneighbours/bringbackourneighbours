---
import { type CollectionEntry, getCollection } from 'astro:content';
import { getCanonicalUrlToFlyer } from '../../../../util/get-canonical-url';
import { mapStaticPathsForStandalone } from '../../../../util/map-static-paths-for-standalone';

interface Props {
  entry: CollectionEntry<'flyers'>;
}

export async function getStaticPaths() {
  return mapStaticPathsForStandalone(await getCollection('flyers'));
}

return Astro.redirect(
  await getCanonicalUrlToFlyer(Astro.props.entry, Astro.props.entry.data.lang),
  301,
);
---
