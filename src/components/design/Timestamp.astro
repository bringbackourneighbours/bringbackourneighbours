---
import { type LanguagesValue } from '../../model/languages';

import { useUiTranslation } from '../../content/use-ui-translation';

export interface Props {
  lastChecked: Date;
  lang: LanguagesValue;
}

const { lastChecked, lang } = Astro.props;
const timestampId = `timestamp-label-${crypto.randomUUID()}`;
---

<span id={timestampId}>{useUiTranslation('meta.updated', lang)}</span>
<time
  datetime={lastChecked.toISOString()}
  aria-describedby={timestampId}
>
  {lastChecked.toLocaleDateString(lang)}
</time>
