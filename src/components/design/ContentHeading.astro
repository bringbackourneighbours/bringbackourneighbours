---
import type { CollectionEntry } from 'astro:content';
import type { StandaloneCollections } from '../../model/standalone-collections';
import { Languages } from '../../model/languages';
import { useContentData } from '../../content/use-content-data';

import ContentMeta from './ContentMeta.astro';
import CopyButton from './CopyButton.astro';
import ShareButton from './ShareButton.astro';
import PdfLink from './PdfLink.astro';
import H1 from './H1.astro';
import CardLink from './CardLink.astro';

interface Props<T extends StandaloneCollections> {
  collection: T;
  entry: CollectionEntry<T>;
  showCopyButton?: boolean;
  showDownloadButton?: boolean;
  germanTitle: string;
  canonicalUrl: string;
  printAllcanonicalUrl?: string;
}

const {
  entry,
  collection,
  showCopyButton = true,
  showDownloadButton = collection !== 'pages',
  germanTitle,
  canonicalUrl,
  printAllcanonicalUrl,
} = Astro.props;
---

<style>
  .german-title {
    display: block;
  }

  .header-meta {
    display: flex;
    justify-content: flex-start;
    gap: var(--bbon-size-gap);
    align-items: baseline;
    flex-wrap: wrap;
    padding-block-end: var(--bbon-size-gap);
    margin-block-end: var(--bbon-size-gap);
    border-block-end: var(--bbon-size-border) solid var(--bbon-color-primary);
  }
</style>

<article aria-labelledby="content-header-heading">
  <header>
    {entry.data.lang !== `${Languages.GERMAN}` && (
      <span class="german-title ltr">{germanTitle}</span>
    )}
    <H1 id="content-header-heading">{entry.data.title}</H1>
    <ContentMeta entry={entry} />

    <div class="header-meta">
      <ShareButton
        title={entry.data.title}
        url={canonicalUrl}
      />
      {showCopyButton && (
        <CopyButton>
          <h1>{entry.data.title}</h1>
          <br />
          <br />
          <slot />
        </CopyButton>
      )}
      {showDownloadButton && (
        <>
          <PdfLink
            collection={collection}
            identifier={entry.data.identifier}
          />
          {printAllcanonicalUrl && (
            <>
              <CardLink
                size="small"
                href={printAllcanonicalUrl}
                lang={entry.data.lang}
                hreflang={entry.data.lang}
              >
                {
                  (await useContentData('pages', 'material', entry.data.lang))
                    ?.title
                }
              </CardLink>
            </>
          )}
        </>
      )}
    </div>
  </header>

  <slot />
</article>
