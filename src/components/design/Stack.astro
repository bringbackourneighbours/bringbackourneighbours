---
interface Props {
  size?: 'small' | 'medium' | 'big';
}

const { size = 'medium' } = Astro.props;

const sizeFactor = size === 'big' ? 1 : size === 'medium' ? 0.5 : 0.25;
---

<style is:global define:vars={{ sizeFactor }}>
  /* we are styling the elements in the slots so we need to have this global */
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bbon-size-gap);
    justify-content: center;

    --threshold: var(--bbon-size-max-text-span);

    & > * {
      flex-grow: 1;
      flex-basis: calc((var(--threshold) - 100%) * 999);
      min-inline-size: calc(var(--sizeFactor) * var(--bbon-size-max-text-span));
      max-inline-size: var(--bbon-size-max-text-span);
    }

    .heading {
      min-inline-size: 100%;
      justify-items: center;
    }
  }
</style>
<div class="stack">
  <div class="heading">
    <slot name="heading" />
  </div>
  <slot />
</div>
