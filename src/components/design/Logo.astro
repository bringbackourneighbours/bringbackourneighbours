---
import logo from '../../assets/logo.svg?raw';
import Icon from './Icon.astro';

interface Props {
  size?: string;
  label?: string;
}

const { size = '1.5em', label } = Astro.props;
---

<style>
  .logo {
    padding: var(--bbon-size-spacing) var(--bbon-size-gap);
  }
</style>
<div class="logo">
  <Icon
    html={logo}
    label={label}
    size={size}
    variant="inverted-primary"
  />
</div>
