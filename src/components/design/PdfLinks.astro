---
import type { StandaloneCollections } from '../../model/standalone-collections';

import { type LanguagesValue, SupportedLanguages } from '../../model/languages';

import PdfLink from './PdfLink.astro';
import Stack from './Stack.astro';

interface Props {
  collection: StandaloneCollections | 'zines';
  identifier?: string;
}

const { collection, identifier = 'all' } = Astro.props;

const showAllLangs = ['zines', 'flyers'].includes(collection);
---

<Stack size="small">
  {
    showAllLangs && (
      <PdfLink
        slot="heading"
        collection={collection}
        identifier={identifier}
        lang="all"
      />
    )
  }
  {
    SupportedLanguages.map((lang) => (
      <PdfLink
        collection={collection}
        identifier={identifier}
        lang={lang}
      />
    ))
  }
</Stack>
